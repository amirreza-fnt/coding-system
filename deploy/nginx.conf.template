# Request Coding Service - Reverse Proxy (HTTP only)
# PUBLIC: __PUBLIC_PORT__  ->  Kestrel 127.0.0.1:__KESTREL_PORT__

upstream requestcodingservice {
    server 127.0.0.1:__KESTREL_PORT__;
    keepalive 64;
}

server {
    listen __PUBLIC_PORT__ default_server;
    listen [::]:__PUBLIC_PORT__ default_server;
    server_name apiweb-requestcoding.sabzevar.ir _;

    client_max_body_size 10m;

    location / {
        proxy_pass http://requestcodingservice;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
